{
  "mcpServers": {
    "OmniSearch": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/sydasif/web-search-mcp.git",
        "omnisearch"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}",
        "AUTH_TOKEN": "${AUTH_TOKEN}",
        "CT0": "${CT0}"
      }
    }
  }
}
